[submodule "lib/forge-std"]
	path = lib/forge-std
	url = https://github.com/foundry-rs/forge-std
[submodule "lib/openzeppelin-contracts"]
	path = lib/openzeppelin-contracts
	url = https://github.com/OpenZeppelin/openzeppelin-contracts
[submodule "lib/continuous-clearing-auction"]
	path = lib/continuous-clearing-auction
	url = https://github.com/Uniswap/continuous-clearing-auction
[submodule "lib/solady"]
	path = lib/solady
	url = https://github.com/Vectorized/solady
[submodule "lib/v4-core"]
	path = lib/v4-core
	url = https://github.com/Uniswap/v4-core
[submodule "lib/v4-periphery"]
	path = lib/v4-periphery
	url = https://github.com/Uniswap/v4-periphery
[submodule "lib/liquidity-launcher"]
	path = lib/liquidity-launcher
	url = https://github.com/Uniswap/liquidity-launcher
	ignore = dirty
[submodule "lib/metavest"]
	path = lib/metavest
	url = https://github.com/MetaLex-Tech/MetaVesT
[submodule "lib/universal-router"]
	path = lib/universal-router
	url = https://github.com/Uniswap/universal-router
[submodule "lib/v2-core"]
	path = lib/v2-core
	url = https://github.com/Uniswap/v2-core
[submodule "lib/v3-core"]
	path = lib/v3-core
	url = https://github.com/Uniswap/v3-core
